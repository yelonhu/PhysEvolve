+def _mrope_position_id_samples(lengths: list[int]) -> list[torch.Tensor]:
+    """Create Qwen3-VL style per-sample position ids with shape (4, seq_len)."""
+
+    samples = []
+    for sample_idx, length in enumerate(lengths):
+        rows = [torch.arange(length) + sample_idx * 100 + axis * 1000 for axis in range(4)]
+        samples.append(torch.stack(rows, dim=0))
+    return samples
+
+
+def _mrope_reference_input_ids(lengths: list[int]) -> torch.Tensor:
+    """Create reference input ids carrying the canonical sequence lengths."""
+
+    return torch.nested.as_nested_tensor([torch.arange(length) for length in lengths], layout=torch.jagged)
+
+
+def _expected_mrope_pack(samples: list[torch.Tensor]) -> torch.Tensor:
+    """Concatenate mRoPE samples into the canonical (4, total_seq_len) layout."""
+
+    return torch.cat([sample if sample.shape[0] == 4 else sample.transpose(0, 1) for sample in samples], dim=-1)
+
+
+def _force_3d_nested_unbind_fallback(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Force tests to exercise the padded fallback for 3D jagged NestedTensors."""
+
+    original_unbind = torch.Tensor.unbind
+
+    def patched_unbind(self, *args, **kwargs):
+        if isinstance(self, torch.Tensor) and self.is_nested and self.dim() == 3:
+            raise RuntimeError("forced 3D jagged NestedTensor unbind fallback")
+        return original_unbind(self, *args, **kwargs)
+
+    monkeypatch.setattr(torch.Tensor, "unbind", patched_unbind)
+
+
