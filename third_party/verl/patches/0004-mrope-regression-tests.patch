+def test_chunk_tensordict_preserves_mrope_position_ids_fallback(monkeypatch: pytest.MonkeyPatch) -> None:
+    lengths = [5, 7, 6, 9]
+    samples = _mrope_position_id_samples(lengths)
+    position_ids = torch.nested.as_nested_tensor(samples, layout=torch.jagged)
+    td = tu.get_tensordict(
+        {
+            "input_ids": torch.nested.as_nested_tensor([torch.arange(length) for length in lengths], layout=torch.jagged),
+            "position_ids": position_ids,
+        }
+    )
+
+    _force_3d_nested_unbind_fallback(monkeypatch)
+    chunks = tu.chunk_tensordict(td, chunks=2)
+
+    first_position_ids = chunks[0]["position_ids"]
+    second_position_ids = chunks[1]["position_ids"]
+    assert first_position_ids.to_padded_tensor(0).shape == torch.Size([2, 4, 7])
+    assert second_position_ids.to_padded_tensor(0).shape == torch.Size([2, 4, 9])
+    assert first_position_ids.values().shape == torch.Size([4, lengths[0] + lengths[1]])
+    assert second_position_ids.values().shape == torch.Size([4, lengths[2] + lengths[3]])
+    assert first_position_ids.values().unsqueeze(1).shape == torch.Size([4, 1, lengths[0] + lengths[1]])
+    assert second_position_ids.values().unsqueeze(1).shape == torch.Size([4, 1, lengths[2] + lengths[3]])
+
+    expected_first = torch.nested.as_nested_tensor(samples[:2], layout=torch.jagged)
+    expected_second = torch.nested.as_nested_tensor(samples[2:], layout=torch.jagged)
+    assert torch.equal(first_position_ids.values(), expected_first.values())
+    assert torch.equal(second_position_ids.values(), expected_second.values())
