+def test_index_select_tensor_dict_preserves_mrope_position_ids_fallback(monkeypatch: pytest.MonkeyPatch) -> None:
+    lengths = [5, 7, 6, 9]
+    samples = _mrope_position_id_samples(lengths)
+    position_ids = torch.nested.as_nested_tensor(samples, layout=torch.jagged)
+    data = tu.get_tensordict(
+        {
+            "position_ids": position_ids,
+            "padded_tensor": torch.arange(len(samples)),
+        }
+    )
+
+    _force_3d_nested_unbind_fallback(monkeypatch)
+    indices = torch.tensor([3, 1])
+    selected_data = tu.index_select_tensor_dict(data, indices)
+    selected_position_ids = selected_data["position_ids"]
+
+    assert selected_position_ids.to_padded_tensor(0).shape == torch.Size([2, 4, 9])
+    assert selected_position_ids.values().shape == torch.Size([4, lengths[3] + lengths[1]])
+    assert selected_position_ids.values().unsqueeze(1).shape == torch.Size([4, 1, lengths[3] + lengths[1]])
+
+    expected = torch.nested.as_nested_tensor([samples[3], samples[1]], layout=torch.jagged)
+    assert torch.equal(selected_position_ids.values(), expected.values())
+    assert torch.equal(selected_data["padded_tensor"], torch.tensor([3, 1]))
